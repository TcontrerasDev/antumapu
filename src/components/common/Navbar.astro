---
import Logo from "../../assets/logo-light.png";
import MobileMenu from "./MobileMenu.astro";
import { wpApi } from "../../lib/wp";
import { buildMenuTree } from "../../lib/utils";
import type { MenuItem } from "../../types/wp";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

// Recuperar navegación y contactos de WordPress de manera segura
const rawNav: MenuItem[] = await wpApi.getNav("menu-primary", lang).catch(() => []);
const navRrss: MenuItem[] = await wpApi.getNav("menu-rrss", lang).catch(() => []);
const navContacto: MenuItem[] = await wpApi.getNav("menu-contacto", lang).catch(() => []);

// Construir árbol jerárquico de navegación respetando parent/children e i18n
const navTree = buildMenuTree(rawNav, lang);

// Obtener y normalizar la ruta actual para el indicador de página activa
const currentPath = Astro.url.pathname;
const normalizePath = (p: string) => {
  if (!p) return "";
  let path = p.replace(/\/$/, ""); // eliminar barra diagonal al final
  return path === "" ? "/" : path;
};
const normalizedCurrent = normalizePath(currentPath);

const checkActive = (itemUrl: string) => {
  if (!itemUrl || itemUrl === "#") return false;
  const normalizedItem = normalizePath(itemUrl);
  if (normalizedItem === "/" || normalizedItem === "/en") {
    return normalizedCurrent === normalizedItem;
  }
  return normalizedCurrent === normalizedItem || normalizedCurrent.startsWith(normalizedItem + "/");
};

const isParentActive = (item: MenuItem): boolean => {
  if (checkActive(item.url || "")) return true;
  if (item.children && item.children.length > 0) {
    return item.children.some((child) => isParentActive(child));
  }
  return false;
};
---

<nav class="w-full flex justify-center">
  <div class="wrapper flex justify-between py-4 items-center">
    <a href={lang === "en" ? "/en" : "/"} class="w-32" aria-label={lang === "en" ? "Home - Antumapu Folkloric Ballet" : "Inicio - Ballet Folklórico Antumapu"}>
      <img src={Logo.src} alt={lang === "en" ? "Antumapu Folkloric Ballet Logo" : "Logo Ballet Folklórico Antumapu"} class="w-full" />
    </a>
    
    <!-- Disparador Hamburguesa Grande e Interactivo (Accesible) -->
    <button
      id="mobile-menu-trigger"
      class="block xl:hidden text-white hover:text-gold-500 focus:text-gold-500 focus:outline-none p-2 rounded-lg transition-colors duration-200 cursor-pointer"
      aria-expanded="false"
      aria-controls="mobile-overlay-menu"
      aria-haspopup="dialog"
      aria-label="Abrir menú de navegación"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="35"
        height="35"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-menu-deep"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M4 6h16"></path>
        <path d="M7 12h13"></path>
        <path d="M10 18h10"></path>
      </svg>
    </button>
    
    <!-- Menú de Escritorio con Submenús Desplegables -->
    <ul class="hidden xl:flex gap-8 items-center font-heading-2">
      {navTree.map((item) => {
        const hasChildren = item.children && item.children.length > 0;
        const isActive = isParentActive(item);

        if (hasChildren) {
          return (
            <li class="relative group py-2 desktop-dropdown-item">
              <a
                href={item.url}
                class:list={[
                  "desktop-dropdown-toggle uppercase text-[16px] tracking-[1.4px] transition-colors duration-300 inline-flex items-center gap-1.5 cursor-pointer py-1",
                  isActive
                    ? "text-gold-500 font-bold"
                    : "text-white-soft group-hover:text-gold-500 group-focus-within:text-gold-500"
                ]}
                aria-haspopup="true"
                aria-expanded="false"
                aria-current={isActive ? "page" : undefined}
              >
                <span>{item.title}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180 group-[.is-open]:rotate-180 text-gold-500/80 group-hover:text-gold-500"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </a>

              {/* Submenú Desplegable Teatral */}
              <div class="desktop-dropdown-menu absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible group-[.is-open]:opacity-100 group-[.is-open]:visible transition-all duration-300 ease-out z-50 transform translate-y-2 group-hover:translate-y-0 group-focus-within:translate-y-0 group-[.is-open]:translate-y-0 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto group-[.is-open]:pointer-events-auto">
                <ul class="min-w-[240px] bg-navy-950/95 backdrop-blur-xl border border-gold-500/30 rounded-none shadow-[0_12px_40px_rgba(0,0,0,0.7)] py-2 overflow-hidden flex flex-col divide-y divide-white/5">
                  {item.children!.map((child) => {
                    const isChildActive = checkActive(child.url || "");
                    return (
                      <li>
                        <a
                          href={child.url}
                          target={child.target || undefined}
                          class:list={[
                            "block px-5 py-3 text-[14px] uppercase tracking-[1.2px] transition-all duration-200 hover:bg-white/5 hover:pl-6",
                            isChildActive
                              ? "text-gold-500 font-bold bg-white/5"
                              : "text-white-soft hover:text-gold-500"
                          ]}
                          aria-current={isChildActive ? "page" : undefined}
                        >
                          {child.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </li>
          );
        }

        return (
          <li class="py-2">
            <a 
              class:list={[
                "uppercase text-[16px] tracking-[1.4px] transition-colors duration-300 py-1",
                isActive 
                  ? "text-gold-500 font-bold" 
                  : "text-white-soft hover:text-gold-500"
              ]} 
              href={item.url}
              aria-current={isActive ? "page" : undefined}
            >
              {item.title}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<!-- Menú Desplegable en Pantalla Completa con Datos de WordPress -->
<MobileMenu nav={rawNav} navRrss={navRrss} navContacto={navContacto} lang={lang} />

<script>
  function initDesktopDropdowns() {
    const dropdownItems = document.querySelectorAll('.desktop-dropdown-item');

    dropdownItems.forEach((item) => {
      const toggle = item.querySelector('.desktop-dropdown-toggle');
      if (!toggle) return;

      if ((toggle as HTMLElement).dataset.dropdownBound === 'true') return;
      (toggle as HTMLElement).dataset.dropdownBound = 'true';

      toggle.addEventListener('click', (e) => {
        const isOpen = item.classList.contains('is-open');

        // Cerrar los otros submenús abiertos
        dropdownItems.forEach((other) => {
          if (other !== item) {
            other.classList.remove('is-open');
            other.querySelector('.desktop-dropdown-toggle')?.setAttribute('aria-expanded', 'false');
          }
        });

        // Si estaba cerrado, abrirlo y prevenir navegación inmediata en táctil/primer clic
        if (!isOpen) {
          e.preventDefault();
          item.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          if (toggle.getAttribute('href') === '#') {
            e.preventDefault();
            item.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        }
      });
    });

    // Cerrar al hacer clic fuera del menú
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      dropdownItems.forEach((item) => {
        if (!item.contains(target)) {
          item.classList.remove('is-open');
          item.querySelector('.desktop-dropdown-toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initDesktopDropdowns);
  if (document.readyState !== 'loading') {
    initDesktopDropdowns();
  } else {
    document.addEventListener('DOMContentLoaded', initDesktopDropdowns);
  }
</script>

