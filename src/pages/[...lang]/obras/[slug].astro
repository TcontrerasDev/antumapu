---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/common/Header.astro";
import Footer from "../../../components/common/Footer.astro";
import Hero from "../../../components/common/Hero.astro";
import Descripcion from "../../../components/features/obras/descripcion.astro";
import { wpApi } from "../../../lib/wp";
import { useTranslations } from "../../../lib/i18n";

export async function getStaticPaths() {
  const locales = ["es", "en"];
  const paths = [];

  for (const lang of locales) {
    const slugs = await wpApi.getSlugObras(lang);
    const isDefault = lang === "es";
    for (const slug of slugs) {
      paths.push({ 
        params: { 
          lang: isDefault ? undefined : lang, 
          slug 
        } 
      });
    }
  }

  return paths;
}

const { lang = "es", slug } = Astro.params;
const obra = await wpApi.getObraBySlug(slug, lang);

if (!obra) return Astro.redirect("/404");

const t = useTranslations(lang);

const repertorio: { nombre: string }[] = (obra.acf.repertorio || []).filter(
  (item) => item && item.nombre && item.nombre.trim() !== ""
);

const galeria = obra.acf.img_galeria_source?.formatted_value || [];

---

<Layout title={obra.title.rendered} lang={lang}>
  <Header theme="dark" lang={lang} />
  <main id="main-content" tabindex="-1" class="focus:outline-none">
    <Hero title={obra.title.rendered} bajada={obra.excerpt.rendered} theme="dark">
      <dl
        class="mt-8 border-t border-gold-500/20 flex flex-col gap-12 py-4 w-max md:gap-25 md:flex-row"
      >
        <div>
          <dt class="text-[14px] tracking-[15%] text-gold-500 font-heading-2 uppercase">
            {t("director")}
          </dt>
          <dd class="text-[20px] mt-4 text-white font-body">{obra.acf.director}</dd>
        </div>
        <div>
          <dt class="text-[14px] tracking-[15%] text-gold-500 font-heading-2 uppercase">{t("duracion")}</dt>
          <dd class="text-[20px] mt-4 text-white font-body">{obra.acf.duracion}</dd>
        </div>
      </dl>
    </Hero>
    <section class="bg-sand-100 padding-section">
      <div class="wrapper">
       {obra.acf.descripcion_obra && ( <h2 class="mb-10 text-h3 font-heading-2 text-navy-950">{obra.acf.titulo_info}</h2>)}
        <div class="grid grid-cols-12">
          <Descripcion
            texto={obra.acf.descripcion_obra}
            video={obra.acf.video_source?.formatted_value || ""}
            class={repertorio.length > 0 ? "lg:col-span-7" : "lg:col-span-12"}
          />
          {
            repertorio.length > 0 && (
              <div class="col-span-full lg:col-span-4 lg:col-start-9 xl:col-span-3 xl:col-start-10 bg-navy-950 px-5 h-max max-lg:mt-10">
                <h3 class="uppercase text-h3 text-white py-3 flex flex-col">
                  {t("repertorio")}
                </h3>
                <ul
                  class="*:border-t *:border-dashed *:border-white"
                >
                  {
                    repertorio.map((baile, index) => (
                      <li class="py-5">
                        <p class="text-white font-heading-2! uppercase text-[20px]">
                          <span class="text-gold-500">{(index + 1).toString().padStart(2, '0')}</span> - {baile.nombre}
                        </p>
                      </li>
                    ))
                  }
                </ul>
              </div>
            )
          }
        </div>
        {
          galeria.length > 0 && (
            <>
              <div class="mt-20">
                <h3 class="text-h3 text-navy-950 mb-10">Galería</h3>
              </div>
              <div id="galeria-obra" class="columns-1 sm:columns-2 md:columns-3 gap-4 space-y-4">
                {
                  galeria.map((img, index) => (
                    <a 
                      href={img.url}
                      data-src={img.url}
                      data-sub-html={`<h4>${img.alt || obra.title.rendered}</h4>`}
                      class="galeria-item block break-inside-avoid overflow-hidden group cursor-pointer"
                    >
                      <img 
                        src={img.url}
                        alt={img.alt || `${obra.title.rendered} - Imagen ${index + 1}`}
                        class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                    </a>
                  ))
                }
              </div>
            </>
          )
        }
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
