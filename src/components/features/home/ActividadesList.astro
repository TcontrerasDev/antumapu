---
import CardActividad from "../../ui/CardActividad.astro";
import { wpApi } from "../../../lib/wp";
import type { WPActividad } from "../../../types/wp";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

const dataActividades: WPActividad[] = await wpApi.getActividades(lang);
---

{
  dataActividades.map((actividad) => (
    <CardActividad
      slug={actividad.slug}
      url={actividad.acf?.url}
      fecha={actividad.acf?.fecha_source?.formatted_value || actividad.acf?.fecha || ""}
      titulo={actividad.title.rendered}
      obra={actividad.acf?.obra || ""}
      lugar={actividad.acf?.lugar || ""}
      direccion={actividad.acf?.direccion || ""}
      hora={actividad.acf?.hora_source?.formatted_value || actividad.acf?.hora || ""}
    />
  ))
}
