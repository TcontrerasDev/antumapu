---
interface Props {
    url: URL | string;
    imgSrc: string;
    titulo: string;
    descripcion?: string;
    classList?: string[];
    class_list?: string[];
    iconoTrofeo?: string;
    icono_trofeo?: string;
    hasPremios?: boolean;
    has_premios?: boolean;
    reconocimientoSource?: {
      formatted_value?: Array<{ premio: string }>;
    };
    reconocimiento_source?: {
      formatted_value?: Array<{ premio: string }>;
    };
}

const { url, imgSrc, titulo, classList, class_list } = Astro.props;
const iconoTrofeo = Astro.props.iconoTrofeo || Astro.props.icono_trofeo;
const classes = classList || class_list || [];
const isCuadroTematico = classes.includes("etiqueta-cuadro-tematico");

const reconocimientos =
  Astro.props.reconocimientoSource?.formatted_value ||
  Astro.props.reconocimiento_source?.formatted_value;

const hasPremios =
  Astro.props.hasPremios ??
  Astro.props.has_premios ??
  (Array.isArray(reconocimientos) &&
    reconocimientos.length > 0 &&
    reconocimientos.some((item) => item?.premio && item.premio.trim() !== ""));

const iconClass = iconoTrofeo || "fa-solid fa-trophy";
---

<article class="h-120 md:h-120 border border-gold-500/20 rounded-xl overflow-hidden group hover:border-gold-500/60 transition-colors duration-300 relative bg-navy-900">
  <a
    href={url}
    class="block h-full w-full relative overflow-hidden"
  >
    <figure class="relative h-full w-full overflow-hidden">
      <!-- Layer Parallax -->
      <div class="embla__parallax__layer relative w-full h-full">
        <img
          src={imgSrc}
          alt={titulo}
          class="embla__parallax__img absolute top-0 left-1/2 -translate-x-1/2 w-[140%] h-full max-w-none object-cover opacity-60 transition-opacity duration-300 group-hover:opacity-75"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/40 to-transparent pointer-events-none"></div>

      <figcaption
        class="absolute bottom-0 left-0 w-full p-6 flex flex-col items-start gap-2 z-10"
      >
        {
          isCuadroTematico && (
            <span class="inline-block px-2.5 py-1 text-[0.7rem] font-heading-2 font-bold uppercase tracking-wider text-gold-500 bg-navy-950/90 border border-gold-500/40 rounded shadow-sm">
              Cuadro Temático
            </span>
          )
        }
        <div class="flex items-end gap-2">
          <h3 class="uppercase text-white font-heading-2 text-xl md:text-2xl font-bold leading-tight" set:html={titulo}>
          </h3>
          {hasPremios && <i class={`${iconClass} text-gold-500 text-base shrink-0 mb-1`} aria-hidden="true"></i>}
        </div>
      </figcaption>
    </figure>
  </a>
</article>
