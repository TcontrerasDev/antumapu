---
interface Props {
  url: URL | string;
  numeracion: number;
  ano: string;
  titulo: string;
  description: string;
  classList?: string[];
  class_list?: string[];
}

const { url, numeracion, ano, titulo, description, classList, class_list } = Astro.props;
const classes = classList || class_list || [];
const isCuadroTematico = classes.includes("etiqueta-cuadro-tematico");

// Separar el título: primera palabra y el resto
const words = titulo.trim().split(/\s+/);
const firstWord = words[0];
const restOfTitle = words.slice(1).join(' ');

// Extraer solo el año: busca cualquier grupo de 4 números seguidos
const yearMatch = ano.match(/\d{4}/);
const yearOnly = yearMatch ? yearMatch[0] : ano;
---

<article>
  <a href={url} class="card-presentacion">
    <div class="info-main">
      <div class="flex flex-col justify-center">
        <p class="ano">{numeracion}</p>
      </div>
      <div class="flex flex-col justify-center">
        {
          isCuadroTematico && (
            <span class="tag-cuadro-tematico">
              Cuadro Temático
            </span>
          )
        }
        <h3 class="flex flex-col justify-center">
          <span class="iniTitulo block" set:html={firstWord}></span>
          <span class="termTitulo block" set:html={restOfTitle}></span>
        </h3>
      </div>
    </div>

    <div class="info-details">
      <div class="flex flex-col justify-center description" set:html={description}>
      </div>
      <div class="flex justify-center gap-5">
        <span class="icon-wrapper">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="arrow-icon"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M5 12l14 0"></path>
            <path d="M13 18l6 -6"></path>
            <path d="M13 6l6 6"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  @reference "../../styles/global.css";

  .card-presentacion {
    @apply grid grid-cols-12 p-4 border-b-[.1px] border-t-[.1px] border-gold-500/20 gap-5 transition-all duration-300;
  
  }

  .card-presentacion:hover {
    @apply bg-sand-100;
  }

  .card-presentacion:focus {
    @apply bg-sand-100;
  }

  .info-main {
    @apply col-span-12 md:col-span-6 lg:col-span-5 flex flex-col gap-2 w-full md:flex-row md:gap-35;
  }

  .info-details {
    @apply col-span-12 md:col-span-6 lg:col-span-7 flex justify-between items-center w-full gap-10 lg:gap-16;
  }

  /* Estilos de Tipografía */
  .ano {
    @apply text-base text-gold-500 font-heading-2! transition-colors duration-300;
  }

  .tag-cuadro-tematico {
    @apply inline-block w-fit mb-1 px-2 py-0.5 text-[11px] font-heading-2 font-semibold uppercase tracking-wider text-gold-500 bg-navy-950/60 border border-gold-500/30 rounded transition-colors duration-300;
  }

  .iniTitulo {
    @apply text-h2 text-white font-semibold transition-colors duration-300;
  }

  .termTitulo {
    @apply text-base text-gold-500 font-body italic transition-colors duration-300;
  }

  .description {
    @apply text-base text-white transition-colors duration-300;
  }
  .arrow-icon {
    @apply w-6 stroke-gold-500 transition-all duration-300;
  }

  /* Efectos al hacer Hover en la Card */
  .card-presentacion:hover .iniTitulo,
  .card-presentacion:hover .description {
    @apply text-navy-950;
  }

  .card-presentacion:hover .termTitulo {
    @apply text-navy-800;
  }
  .card-presentacion:hover .ano {
    @apply text-navy-800!;
  }
  .card-presentacion:hover .tag-cuadro-tematico {
    @apply text-navy-950 bg-gold-500/20 border-gold-700/40;
  }
  .card-presentacion:hover .arrow-icon {
    @apply stroke-gold-700 rotate-[-30deg];
  }

  .card-presentacion:focus .iniTitulo,
  .card-presentacion:focus .description {
    @apply text-navy-950;
  }

  .card-presentacion:focus .termTitulo {
    @apply text-navy-800;
  }
  .card-presentacion:focus .ano {
    @apply text-navy-800!;
  }
  .card-presentacion:focus .tag-cuadro-tematico {
    @apply text-navy-950 bg-gold-500/20 border-gold-700/40;
  }
  .card-presentacion:focus .arrow-icon {
    @apply stroke-gold-700 rotate-[-30deg];
  }
</style>
