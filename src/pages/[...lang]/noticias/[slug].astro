---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/common/Header.astro";
import Footer from "../../../components/common/Footer.astro";
import NoticiaDetalle from "../../../components/features/noticias/NoticiaDetalle.astro";
import { wpApi } from "../../../lib/wp";
import { getBreadcrumbs } from "../../../lib/utils";
import { useTranslations } from "../../../lib/i18n";

export async function getStaticPaths() {
  const locales = ["es", "en"];
  const paths = [];

  for (const lang of locales) {
    const slugs = await wpApi.getSlugNoticias(lang).catch(() => []);
    const isDefault = lang === "es";
    for (const slug of slugs) {
      paths.push({
        params: {
          lang: isDefault ? undefined : lang,
          slug,
        },
      });
    }
  }

  return paths;
}

const { lang = "es", slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

// Obtención ultra-rápida de metadatos SEO y de cabecera
let noticiaMetadata = null;
try {
  noticiaMetadata = await wpApi.getNoticiaMetadataBySlug(slug, lang);
} catch (error) {
  console.error("Error fetching news metadata:", error);
}
if (!noticiaMetadata) return Astro.redirect("/404");

const t = useTranslations(lang);

const breadcrumbs = getBreadcrumbs(Astro.url.pathname).filter(
  (bc) => bc.name.toLowerCase() !== "en" && bc.name.toLowerCase() !== "es"
);
if (breadcrumbs.length > 0 && noticiaMetadata?.title?.rendered) {
  breadcrumbs[breadcrumbs.length - 1].name = noticiaMetadata.title.rendered;
}

const bgClass = "bg-navy-950/10";
const textClass = "bg-navy-800/10";
const goldClass = "bg-gold-700/20";
---

<Layout title={noticiaMetadata.title.rendered} lang={lang}>
  <Header theme="light" lang={lang} />
  <main id="main-content" tabindex="-1" class="bg-sand-100 pt-30 pb-20 focus:outline-none">
    <section>
      <div class="wrapper">
        <!-- Migas de pan renderizadas de inmediato -->
        <nav aria-label={lang === "en" ? "Breadcrumbs" : "Migas de pan"} class="text-gold-500 font-heading-2 tracking-[1.4px]">
          <ol class="flex flex-wrap list-none p-0 m-0">
            <li class="inline-flex items-center">
              <a
                href={lang === "es" ? "/" : `/${lang}`}
                class="text-navy-950"
                >{t("inicio")}</a
              >
              <span class="mx-1.5 opacity-60" aria-hidden="true">/</span>
            </li>
            {
              breadcrumbs.map((bc) =>
                bc.isLast ? (
                  <li class="inline-flex items-center" aria-current="page">
                    <span class="text-gold-700" set:html={bc.name} />
                  </li>
                ) : (
                  <li class="inline-flex items-center">
                    <a
                      href={bc.url}
                      class="text-navy-950"
                    >
                      {bc.name}
                    </a>
                    <span class="mx-1.5 opacity-60" aria-hidden="true">/</span>
                  </li>
                ),
              )
            }
          </ol>
        </nav>

        <!-- Título y descripción/extracto renderizados de inmediato (SEO) -->
        <h1
          class="text-[#005ba3] text-h2 font-heading-2 mt-4"
          set:html={noticiaMetadata.title.rendered}
        />
        <div
          class="text-[18px] lg:text-1xl pt-5 text-navy-950 w-full lg:w-3/4"
          set:html={noticiaMetadata.excerpt.rendered}
        />

        <!-- Contenido renderizado estáticamente -->
        <NoticiaDetalle slug={slug} lang={lang} />
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
