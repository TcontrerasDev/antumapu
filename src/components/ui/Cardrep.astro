---
interface Props {
  url: URL | string;
  numeracion: number;
  ano: string;
  titulo: string;
  description: string;
  classList?: string[];
  class_list?: string[];
  iconoTrofeo?: string;
  icono_trofeo?: string;
  hasPremios?: boolean;
  has_premios?: boolean;
  reconocimientoSource?: {
    formatted_value?: Array<{ premio: string }>;
  };
  reconocimiento_source?: {
    formatted_value?: Array<{ premio: string }>;
  };
}

const { url, numeracion, ano, titulo, description, classList, class_list } = Astro.props;
const iconoTrofeo = Astro.props.iconoTrofeo || Astro.props.icono_trofeo;
const classes = classList || class_list || [];
const isCuadroTematico = classes.includes("etiqueta-cuadro-tematico")
const iconClass = iconoTrofeo || "fa-solid fa-trophy";

const reconocimientos =
  Astro.props.reconocimientoSource?.formatted_value ||
  Astro.props.reconocimiento_source?.formatted_value;

const hasPremios =
  Astro.props.hasPremios ??
  Astro.props.has_premios ??
  (Array.isArray(reconocimientos) &&
    reconocimientos.length > 0 &&
    reconocimientos.some((item) => item?.premio && item.premio.trim() !== ""));
---

<article>
  <a href={url} class="card-presentacion">
    <div class="info-main">
      <div class="flex flex-col justify-center">
        <p class="ano">{numeracion}</p>
      </div>
      <div class="flex flex-col justify-center">
        {
          isCuadroTematico && (
            <span class="tag-cuadro-tematico">
              Cuadro Temático
            </span>
          )
        }
        <div class="flex items-end gap-2">
          <h2 class="iniTitulo" set:html={titulo}>
          </h2>
          {hasPremios && <i class={`${iconClass} icono-trofeo pb-1.25`} aria-hidden="true"></i>}
        </div>
      </div>
    </div>

    <div class="info-details">
      <div class="flex flex-col justify-center description" set:html={description}>
      </div>
      <div class="flex justify-center gap-5">
        <span class="icon-wrapper">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="arrow-icon"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M5 12l14 0"></path>
            <path d="M13 18l6 -6"></path>
            <path d="M13 6l6 6"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  @reference "../../styles/global.css";

  .card-presentacion {
    @apply grid grid-cols-12 p-4 border-b-[.1px] border-t-[.1px] border-gold-500/20 gap-5 transition-all duration-300 min-h-30;
  
  }

  .card-presentacion:hover {
    @apply bg-sand-100;
  }

  .card-presentacion:focus {
    @apply bg-sand-100;
  }

  .info-main {
    @apply col-span-12 md:col-span-6 lg:col-span-5 flex flex-col gap-2 w-full md:flex-row md:gap-35;
  }

  .info-details {
    @apply col-span-12 pb-3 md:pb-0 md:col-span-6 lg:col-span-7 flex justify-between items-center w-full gap-10 lg:gap-16;
  }

  /* Estilos de Tipografía */
  .ano {
    @apply text-base text-white font-heading-2! transition-colors duration-300;
  }

  .tag-cuadro-tematico {
    @apply inline-block w-fit mb-1 px-2 py-0.5 text-[11px] font-heading-2 font-semibold uppercase tracking-wider text-white bg-navy-950/60 border border-gold-500/30 rounded transition-colors duration-300;
  }

  .iniTitulo {
    @apply text-[2rem] text-gold-500 font-semibold transition-colors duration-300;
  }

  .icono-trofeo {
    @apply text-[1rem] text-gold-500 transition-colors duration-300 shrink-0;
  }

  .description {
    @apply text-base text-white transition-colors duration-300;
  }
  .arrow-icon {
    @apply w-6 stroke-gold-500 transition-all duration-300;
  }

  /* Efectos al hacer Hover en la Card */
  .card-presentacion:hover .iniTitulo,
  .card-presentacion:hover .icono-trofeo,
  .card-presentacion:hover .description {
    @apply text-navy-950;
  }

  .card-presentacion:hover .termTitulo {
    @apply text-navy-800;
  }
  .card-presentacion:hover .ano {
    @apply text-navy-800!;
  }
  .card-presentacion:hover .tag-cuadro-tematico {
    @apply text-navy-950 bg-gold-500/20 border-gold-700/40;
  }
  .card-presentacion:hover .arrow-icon {
    @apply stroke-gold-700 rotate-[-30deg];
  }

  .card-presentacion:focus .iniTitulo,
  .card-presentacion:focus .icono-trofeo,
  .card-presentacion:focus .description {
    @apply text-navy-950;
  }

  .card-presentacion:focus .termTitulo {
    @apply text-navy-800;
  }
  .card-presentacion:focus .ano {
    @apply text-navy-800!;
  }
  .card-presentacion:focus .tag-cuadro-tematico {
    @apply text-navy-950 bg-gold-500/20 border-gold-700/40;
  }
  .card-presentacion:focus .arrow-icon {
    @apply stroke-gold-700 rotate-[-30deg];
  }
</style>
