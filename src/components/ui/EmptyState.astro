---
import ButtonBg from "./ButtonBg.astro";

interface Props {
  title: string;
  description: string;
  actionText?: string;
  actionHref?: string;
  theme?: "light" | "dark";
}

const {
  title,
  description,
  actionText,
  actionHref,
  theme = "light",
} = Astro.props;
---

<div
  class:list={[
    "w-full px-6 sm:px-12 text-center flex flex-col items-center justify-center my-4 transition-all duration-300",
    {
      "bg-navy-900/40": theme === "dark",
    },
  ]}
>
  <div
    class:list={[
      "w-16 h-16 rounded-full flex items-center justify-center mb-5 border transition-transform duration-300 hover:scale-105",
      {
        "bg-gold-500/10 text-gold-700 border-gold-500/30": theme === "light",
        "bg-gold-500/15 text-gold-500 border-gold-500/40": theme === "dark",
      },
    ]}
  >
    <svg
      class="w-8 h-8"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5"
      ></path>
    </svg>
  </div>

  <h3
    class:list={[
      "font-heading-2 text-2xl sm:text-3xl font-bold uppercase tracking-wider mb-3",
      {
        "text-navy-950": theme === "light",
        "text-sand-100": theme === "dark",
      },
    ]}
  >
    {title}
  </h3>

  <p
    class:list={[
      "font-body text-base sm:text-lg max-w-md mb-8 leading-relaxed",
      {
        "text-navy-800/80": theme === "light",
        "text-white-soft/80": theme === "dark",
      },
    ]}
  >
    {description}
  </p>

  {
    actionText && actionHref && (
      <ButtonBg href={actionHref}>
        {actionText}
      </ButtonBg>
    )
  }
</div>
