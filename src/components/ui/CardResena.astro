---
import { Image } from "astro:assets";

interface Props {
  imagen?: ImageMetadata | string | null;
  titulo: string;
  excerpt: string;
  content: string;
  theme?: "dark" | "light";
  class?: string;
}

const {
  imagen,
  titulo,
  excerpt,
  content,
  theme = "light",
  class: className = "",
} = Astro.props;
---

<article
  class:list={[
    "card-resena relative flex flex-col h-full p-2 rounded-2xl select-none flex-1 shadow-none transition-colors duration-300",
    className,
  ]}
>
  <!-- Icono Decorativo de Comillas -->
  <!-- Información del autor -->
  <div
    class="flex items-center gap-4 mb-6 pb-6 border-b border-gold-500/20 relative z-10"
  >
    <div
      class="relative w-14 h-14 rounded-full overflow-hidden shrink-0 border-2 border-gold-500/80 shadow-none flex items-center justify-center bg-gold-500/10"
    >
      {
        imagen ? (
          typeof imagen === "string" ? (
            <img src={imagen} alt={titulo} class="w-full h-full object-cover" />
          ) : (
            <Image
              src={imagen}
              alt={titulo}
              class="w-full h-full object-cover"
              width={400}
              height={400}
            />
          )
        ) : (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-7 h-7 text-gold-500"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
            />
          </svg>
        )
      }
    </div>
    <div class="flex flex-col">
      <h3
        class:list={[
          "font-heading-2 font-bold text-lg uppercase tracking-wide",
          theme === "dark" ? "text-sand-100" : "text-navy-950",
        ]}
        set:html={titulo}
      />
      <div
        class="text-xs uppercase tracking-wider font-heading-2 text-navy-800 [&>p]:m-0"
        set:html={excerpt}
      />
    </div>
  </div>

  <div
    class="absolute top-6 right-6 text-gold-500/20 group-hover:text-gold-500/40 transition-colors pointer-events-none"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-12 h-12 fill-current"
      viewBox="0 0 24 24"
    >
      <path
        d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
      ></path>
    </svg>
  </div>

  <div class="flex flex-col gap-4 relative z-10">

    <!-- Contenido de la reseña -->
    <div
      class:list={[
        "text-base italic leading-relaxed font-body [&>p]:m-0",
        theme === "dark" ? "text-white-soft" : "text-navy-800",
      ]}
      set:html={content}
    />
  </div>
</article>
