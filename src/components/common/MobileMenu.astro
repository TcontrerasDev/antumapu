---
// src/components/common/MobileMenu.astro
import Logo from "../../assets/logo-light.png";
import { wpApi } from "../../lib/wp";
import { buildMenuTree } from "../../lib/utils";
import type { MenuItem } from "../../types/wp";

interface Props {
  nav?: MenuItem[];
  navRrss?: MenuItem[];
  navContacto?: MenuItem[];
  lang?: string;
}

const { nav: navProp, navRrss: navRrssProp, navContacto: navContactoProp, lang = "es" } = Astro.props;

// Intentar consumir menús desde WordPress vía wpApi si no se proporcionaron vía props o vienen vacíos
const fetchedNav: MenuItem[] = (navProp && navProp.length > 0)
  ? navProp
  : await wpApi.getNav("menu-primary", lang).catch(() => []);

const fetchedRrss: MenuItem[] = (navRrssProp && navRrssProp.length > 0)
  ? navRrssProp
  : await wpApi.getNav("menu-rrss", lang).catch(() => []);

const fetchedContacto: MenuItem[] = (navContactoProp && navContactoProp.length > 0)
  ? navContactoProp
  : await wpApi.getNav("menu-contacto", lang).catch(() => []);

// Fallbacks estáticos en caso de que la API de WordPress no responda o devuelva un menú vacío
const fallbackNav: MenuItem[] = lang === "en" ? [
  { id: 1, title: "Home", url: "/en", parent: "0" },
  { id: 2, title: "History", url: "/en/historia", parent: "0" },
  { id: 3, title: "Repertoire", url: "/en/obras", parent: "0" },
  { id: 4, title: "Activities", url: "/en/actividades", parent: "0" },
] : [
  { id: 1, title: "Inicio", url: "/", parent: "0" },
  { id: 2, title: "Historia", url: "/historia", parent: "0" },
  { id: 3, title: "Repertorio", url: "/obras", parent: "0" },
  { id: 4, title: "Actividades", url: "/actividades", parent: "0" },
];

const fallbackRrss: MenuItem[] = [
  { title: "Facebook", url: "https://www.facebook.com/balletantumapu", acf: { icono: "bi bi-facebook" } },
  { title: "Instagram", url: "https://www.instagram.com/ballet_antumapu", acf: { icono: "bi bi-instagram" } },
  { title: "YouTube", url: "https://www.youtube.com/user/AntumapuChile", acf: { icono: "bi bi-youtube" } }
];

const fallbackContacto: MenuItem[] = [
  { title: "Llamar", url: "tel:+56229787500", acf: { icono: "bi bi-telephone" } },
];

const rawMenuItems: MenuItem[] = fetchedNav.length > 0 ? fetchedNav : fallbackNav;
const rrRssItems: MenuItem[] = fetchedRrss.length > 0 ? fetchedRrss : fallbackRrss;
const contactoItems: MenuItem[] = fetchedContacto.length > 0 ? fetchedContacto : fallbackContacto;

// Construir árbol jerárquico de navegación
const menuItems = buildMenuTree(rawMenuItems, lang);

// Obtener y normalizar la ruta actual para el indicador de página activa
const currentPath = Astro.url.pathname;
const normalizePath = (p: string) => {
  if (!p) return "";
  let path = p.replace(/\/$/, "");
  return path === "" ? "/" : path;
};
const normalizedCurrent = normalizePath(currentPath);

const checkActive = (itemUrl: string) => {
  if (!itemUrl || itemUrl === "#") return false;
  const normalizedItem = normalizePath(itemUrl);
  if (normalizedItem === "/" || normalizedItem === "/en") {
    return normalizedCurrent === normalizedItem;
  }
  return normalizedCurrent === normalizedItem || normalizedCurrent.startsWith(normalizedItem + "/");
};

const isParentActive = (item: MenuItem): boolean => {
  if (checkActive(item.url || "")) return true;
  if (item.children && item.children.length > 0) {
    return item.children.some((child) => isParentActive(child));
  }
  return false;
};
---

<div
  id="mobile-overlay-menu"
  class="fixed inset-0 w-screen h-screen z-50 bg-[radial-gradient(ellipse_at_center,_var(--color-navy-800)_0%,_var(--color-navy-950)_100%)] transition-all duration-300 ease-in-out invisible opacity-0 pointer-events-none xl:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación móvil"
  data-lenis-prevent
>
  <!-- Efecto de Brillo Central e Iluminación de Escenario (Spotlights con tonalidades de #e0b24a) -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(224,178,74,0.22)_0%,_transparent_40%)] pointer-events-none"></div>

  <!-- Logotipo Sutil en la Cabecera (Branding) -->
  <div class="absolute top-4 left-4 sm:top-6 sm:left-6 flex items-center gap-3 pointer-events-none select-none z-20">
    <div class="w-16 sm:w-24 opacity-30">
      <img src={Logo.src} alt="Logo Antumapu" class="w-full filter drop-shadow-[0_0_8px_rgba(224,178,74,0.2)]" />
    </div>
  </div>

  <!-- Botón de Cierre Grande y Accesible con Texto de Ayuda (Cierre Asistido) -->
  <button
    id="mobile-menu-close"
    class="absolute top-4 right-4 sm:top-6 sm:right-6 p-2 sm:p-3 text-[#FCFCFC] hover:text-gold-500 focus:text-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500 rounded-none border border-white/10 hover:border-gold-500/30 transition-all duration-300 bg-navy-950/80 backdrop-blur-md hover:bg-white/10 active:scale-95 flex flex-col items-center justify-center cursor-pointer min-w-[64px] min-h-[64px] sm:min-w-[76px] sm:min-h-[76px] z-20"
    aria-label="Cerrar menú de navegación"
  >
    <!-- Icono X de alta visibilidad -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="sm:w-[28px] sm:h-[28px] transition-transform duration-300"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
    <!-- Texto de ayuda complementario para adultos mayores -->
    <span class="font-heading-2 text-[9px] sm:text-[10px] tracking-[1.5px] uppercase mt-0.5 sm:mt-1 opacity-80 select-none">Cerrar</span>
  </button>

  <!-- Contenedor con Scroll para evitar desbordamiento en pantallas pequeñas/horizontales -->
  <div class="w-full h-full overflow-y-auto flex flex-col z-10" data-lenis-prevent>
    <div class="w-full min-h-full flex flex-col items-center py-24 sm:py-28 px-6 sm:px-8">
      <div class="my-auto w-full flex flex-col items-center">
        <!-- Enlaces de Navegación Verticales Centrados -->
        <nav class="w-full max-w-lg menu-content">
          <ul class="flex flex-col items-center justify-center space-y-3.5 sm:space-y-5">
            {
              menuItems.map((item, index) => {
                const hasChildren = item.children && item.children.length > 0;
                const isActive = isParentActive(item);

                if (hasChildren) {
                  return (
                    <li
                      class="w-full text-center mobile-menu-item flex flex-col items-center"
                      style={`transition-delay: ${0.1 + index * 0.05}s`}
                    >
                      <div class="flex items-center justify-center gap-2 w-full">
                        <a
                          href={item.url}
                          target={item.target || undefined}
                          class:list={[
                            "mobile-menu-link block py-2.5 sm:py-3.5 pl-6 sm:pl-8 pr-2 font-heading-2 text-2xl sm:text-4xl uppercase tracking-[2px] sm:tracking-[3px] transition-all duration-300 hover:bg-white/5 focus:bg-white/5 focus:outline-none active:scale-98",
                            isActive
                              ? "text-gold-500 font-bold"
                              : "text-[#FCFCFC] hover:text-gold-500 focus:text-gold-500"
                          ]}
                          aria-current={isActive ? "page" : undefined}
                        >
                          {item.title}
                        </a>
                        <button
                          type="button"
                          class="mobile-submenu-toggle p-2 text-gold-500 hover:text-white transition-transform duration-300 cursor-pointer"
                          aria-expanded="false"
                          aria-label={`Desplegar submenú para ${item.title}`}
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6 sm:w-7 sm:h-7 transition-transform duration-300 chevron-icon"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M6 9l6 6 6-6" />
                          </svg>
                        </button>
                      </div>

                      {/* Submenú Desplegable Móvil */}
                      <ul class="mobile-submenu hidden flex-col items-center gap-2 mt-2 py-3 px-4 w-full max-w-sm bg-white/5 border-l-2 border-gold-500/40 rounded-none transition-all duration-300">
                        {item.children!.map((child) => {
                          const isChildActive = checkActive(child.url || "");
                          return (
                            <li class="w-full text-center">
                              <a
                                href={child.url}
                                target={child.target || undefined}
                                class:list={[
                                  "mobile-menu-link block py-2 px-4 font-heading-2 text-lg sm:text-xl uppercase tracking-[1.5px] transition-all duration-200 hover:text-gold-500",
                                  isChildActive
                                    ? "text-gold-500 font-bold"
                                    : "text-white-soft hover:text-gold-500"
                                ]}
                                aria-current={isChildActive ? "page" : undefined}
                              >
                                {child.title}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </li>
                  );
                }

                return (
                  <li
                    class="w-full text-center mobile-menu-item"
                    style={`transition-delay: ${0.1 + index * 0.05}s`}
                  >
                    <a
                      href={item.url}
                      target={item.target || undefined}
                      class:list={[
                        "mobile-menu-link block py-2.5 sm:py-3.5 px-6 sm:px-8 w-full font-heading-2 text-2xl sm:text-4xl uppercase tracking-[2px] sm:tracking-[3px] transition-all duration-300 rounded-none hover:bg-white/5 focus:bg-white/5 focus:outline-none active:scale-98",
                        isActive
                          ? "text-gold-500 font-bold bg-white/5"
                          : "text-[#FCFCFC] hover:text-gold-500 focus:text-gold-500"
                      ]}
                      aria-current={isActive ? "page" : undefined}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <!-- Enlaces Rápidos de Contacto y Redes Sociales (Base del Menú) -->
        <div class="my-8 sm:mt-10 w-full max-w-md px-6 sm:px-8 text-center select-none mobile-menu-footer">
          <!-- Línea decorativa sutil -->
          <div class="opacity-20 w-24 h-[1px] bg-gold-500 mx-auto mb-5 sm:mb-6"></div>

          <!-- Botones de contacto de fácil acceso táctil -->
          <div class="flex flex-wrap justify-center gap-3 sm:gap-4 mb-5 sm:mb-6">
            {contactoItems.map(item => {
              const title = item.title || item.name || item.label || "";
              const url = item.url || item.link || item.href || "#";
              const isExternal = url.startsWith("http");
              return (
                <a
                  href={url}
                  class="mobile-contact-link flex items-center gap-2.5 py-2 sm:py-2.5 px-4 sm:px-5 bg-white/5 hover:bg-white/10 active:scale-95 text-[#FCFCFC] hover:text-gold-500 border border-white/10 hover:border-gold-500/30 rounded-none transition-all duration-300 font-heading-2 text-[12px] sm:text-[13px] uppercase tracking-[1px] min-h-[44px] sm:min-h-[48px] cursor-pointer"
                  target={item.target || (isExternal ? "_blank" : undefined)}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                >
                  {item.acf?.icono && <i class={`${item.acf.icono} text-[15px] sm:text-[16px]`}></i>}
                  <span>{title}</span>
                </a>
              );
            })}
          </div>

          <!-- Iconos Redes Sociales -->
          <div class="flex flex-wrap justify-center gap-4 sm:gap-5">
            {rrRssItems.map(item => {
              const title = item.title || item.name || item.label || "";
              const url = item.url || item.link || item.href || "#";
              const isExternal = url.startsWith("http");
              return (
                <a
                  href={url}
                  class="mobile-contact-link flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 bg-white/5 hover:bg-white/10 active:scale-90 text-[#FCFCFC] hover:text-gold-500 rounded-none border border-white/10 transition-all duration-300 cursor-pointer"
                  target={item.target || (isExternal ? "_blank" : undefined)}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  title={title}
                  aria-label={`Visitar nuestro ${title}`}
                >
                  {item.acf?.icono && <i class={`${item.acf.icono} text-[16px] sm:text-[18px]`}></i>}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Animación Teatral para la Pantalla Completa */
  #mobile-overlay-menu {
    transition: opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.4s;
  }
  
  #mobile-overlay-menu.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
  
  /* El contenido del menú se escala y se desplaza al abrirse simulando un telón */
  #mobile-overlay-menu .menu-content {
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.5s ease;
    transform: scale(0.9) translateY(30px);
    opacity: 0;
  }
  
  #mobile-overlay-menu.is-open .menu-content {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  /* Animación escalonada (Staggered) para los enlaces de navegación */
  #mobile-overlay-menu .mobile-menu-item {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
    transform: translateY(40px);
    opacity: 0;
  }

  #mobile-overlay-menu.is-open .mobile-menu-item {
    transform: translateY(0);
    opacity: 1;
  }

  /* Animación final escalonada para la base del menú */
  #mobile-overlay-menu .mobile-menu-footer {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
    transform: translateY(30px);
    opacity: 0;
    transition-delay: 0.36s;
  }

  #mobile-overlay-menu.is-open .mobile-menu-footer {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  declare global {
    interface Window {
      lenis: any;
    }
  }

  function initMobileMenu() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const menu = document.getElementById('mobile-overlay-menu');
    const closeBtn = document.getElementById('mobile-menu-close');
    const links = document.querySelectorAll('.mobile-menu-link');
    const contactLinks = document.querySelectorAll('.mobile-contact-link');

    if (!trigger || !menu || !closeBtn) return;

    // Función de vibración háptica ligera para dispositivos táctiles (15ms)
    function triggerHaptic() {
      if (typeof window !== 'undefined' && window.navigator && window.navigator.vibrate) {
        window.navigator.vibrate(15);
      }
    }

    // Abrir el menú de pantalla completa
    function openMenu() {
      menu?.classList.add('is-open');
      trigger?.setAttribute('aria-expanded', 'true');
      
      // Bloquear scroll de fondo nativo y Lenis
      document.body.classList.add('overflow-hidden');
      document.documentElement.classList.add('overflow-hidden');
      if (window.lenis) {
        window.lenis.stop();
      }

      // Colocar el foco en el botón de cierre para accesibilidad
      closeBtn?.focus();

      // Habilitar controles de teclado
      document.addEventListener('keydown', handleKeyDown);
    }

    // Cerrar el menú de pantalla completa
    function closeMenu() {
      menu?.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
      
      // Restaurar scroll de fondo nativo y Lenis
      document.body.classList.remove('overflow-hidden');
      document.documentElement.classList.remove('overflow-hidden');
      if (window.lenis) {
        window.lenis.start();
      }

      // Devolver el foco al disparador hamburguesa
      (trigger as HTMLElement)?.focus();

      // Remover controles de teclado
      document.removeEventListener('keydown', handleKeyDown);
    }

    // Toggle de Submenús en Móvil
    const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
    submenuToggles.forEach((toggleBtn) => {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerHaptic();
        const parentLi = toggleBtn.closest('.mobile-menu-item');
        const submenu = parentLi?.querySelector('.mobile-submenu');
        const chevron = toggleBtn.querySelector('.chevron-icon') as HTMLElement;

        if (submenu) {
          const isOpen = !submenu.classList.contains('hidden');
          if (isOpen) {
            submenu.classList.add('hidden');
            submenu.classList.remove('flex');
            toggleBtn.setAttribute('aria-expanded', 'false');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
          } else {
            submenu.classList.remove('hidden');
            submenu.classList.add('flex');
            toggleBtn.setAttribute('aria-expanded', 'true');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          }
        }
      });
    });

    // Controlar el foco del teclado (Focus Trap) y tecla Escape
    function handleKeyDown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        triggerHaptic();
        closeMenu();
        return;
      }

      if (e.key === 'Tab') {
        const focusableElements = [closeBtn, ...Array.from(links), ...Array.from(contactLinks)] as HTMLElement[];
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.shiftKey) { // Shift + Tab (hacia atrás)
          if (document.activeElement === firstElement) {
            lastElement.focus();
            e.preventDefault();
          }
        } else { // Tab (hacia adelante)
          if (document.activeElement === lastElement) {
            firstElement.focus();
            e.preventDefault();
          }
        }
      }
    }

    // Eventos con vibración háptica integrada
    trigger.addEventListener('click', () => {
      triggerHaptic();
      openMenu();
    });

    closeBtn.addEventListener('click', () => {
      triggerHaptic();
      closeMenu();
    });

    // Cerrar al hacer clic en un enlace y vibrar
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href === '#') {
          const parentLi = link.closest('.mobile-menu-item');
          const toggleBtn = parentLi?.querySelector('.mobile-submenu-toggle') as HTMLElement;
          if (toggleBtn) {
            e.preventDefault();
            toggleBtn.click();
            return;
          }
        }
        triggerHaptic();
        closeMenu();
      });
    });

    // Vibrar al presionar los enlaces de contacto y redes
    contactLinks.forEach(cl => {
      cl.addEventListener('click', () => {
        triggerHaptic();
      });
    });

    // Cerrar automáticamente si la pantalla se agranda a >= 1280px (xl)
    const mediaQuery = window.matchMedia('(min-width: 1280px)');
    function handleResize(e: MediaQueryListEvent | MediaQueryList) {
      if (e.matches && menu?.classList.contains('is-open')) {
        closeMenu();
      }
    }
    
    // Escuchar cambios de resolución
    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener('change', handleResize);
    } else if ('addListener' in mediaQuery) {
      (mediaQuery as any).addListener(handleResize);
    }
  }

  // Inicializar en carga de página de Astro (compatible con View Transitions)
  document.addEventListener('astro:page-load', () => {
    initMobileMenu();
  });
</script>

